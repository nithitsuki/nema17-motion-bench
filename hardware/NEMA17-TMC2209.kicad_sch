	(text "NEMA 17 + TMC2209 + WeAct STM32G474CEU6"
		(exclude_from_sim no)
		(at 12.7 16.51 0)
		(effects
			(font
				(size 3.0 3.0)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "35fa54fa-ffab-44e7-8572-ad17510a6241")
	)
	(text "Motor: JK42HS48-1684-03F   1.8 deg, 1.68 A/phase, 1.65 ohm, 2.8 mH, 4.4 kg-cm, 48 mm body"
		(exclude_from_sim no)
		(at 12.7 24.13 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "542848f6-9ccd-4786-8c4b-e45c86484bf8")
	)
	(text "Driver: BIGTREETECH TMC2209 V1.3 in a 2x8 StepStick socket.  VS = 24 V, VIO = 3.3 V."
		(exclude_from_sim no)
		(at 12.7 27.94 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "aba535db-bf64-4181-ac13-4478fc70b06f")
	)
	(text "WIRING TABLE"
		(exclude_from_sim no)
		(at 12.7 35.56 0)
		(effects
			(font
				(size 2.0 2.0)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "17eb09a7-e6ce-4aea-8bd7-b79587e907d3")
	)
	(text "WeAct pin     Driver pin        Net\nPA0  (A0)  ->  15 STEP          STEP\nPA1  (A1)  ->  16 DIR           DIR\nPA4  (A4)  ->   9 EN            EN\nPA2  (A2)  ->  R1 1k -> 12 RX   PDN_UART\nPA3  (A3)  ->  12 RX            PDN_UART\nPB0  (B0)  ->  10 MS1           MS1\nPB1  (B1)  ->  11 MS2           MS2\nPB10 (B10) ->  J2-2 DIAG        DIAG\nPB11 (B11) ->  J2-1 INDEX       INDEX\n3V3        ->   2 VIO           +3V3\nGND        ->   1,7 GND         GND"
		(exclude_from_sim no)
		(at 12.7 40.64 0)
		(effects
			(font
				(size 1.6 1.6)
			)
			(justify left top)
		)
		(uuid "6880facb-f647-4540-8e1a-8d729c42c772")
	)
	(text "MOTOR (J3)      DRIVER (J1)\n1 A+ RED   ->   5 A1\n2 A- GRN   ->   6 A2\n3 B+ YEL   ->   4 B1\n4 B- BLU   ->   3 B2"
		(exclude_from_sim no)
		(at 12.7 73.66 0)
		(effects
			(font
				(size 1.6 1.6)
			)
			(justify left top)
		)
		(uuid "ad576c04-177d-40af-92fb-2f97c527c1e6")
	)
	(text "CURRENT SETTING\nRsense on the module = 0.11 ohm (2x).\nI_RMS = 0.707 x VREF  (VREF in volts)\nVREF = 1.68 V -> 1.19 A RMS.\nThe motor is rated 1.68 A. Do not exceed\nVREF = 2.37 V (1.68 A RMS) unless the\ncase stays below 80 C.\nMeasure VREF at TP2."
		(exclude_from_sim no)
		(at 12.7 90.17 0)
		(effects
			(font
				(size 1.6 1.6)
			)
			(justify left top)
		)
		(uuid "30d6b881-5f25-4ca4-b307-a3b760559f7f")
	)
	(text "UART\nSingle wire, 8N1, 9 kBd to fCLK/16.\nSet GCONF.pdn_disable = 1.\nNode address 0 (MS1 = MS2 = 0).\nModule UART_TX (pin 13) is isolated by\nR10, which is not fitted. Use pin 12."
		(exclude_from_sim no)
		(at 12.7 114.3 0)
		(effects
			(font
				(size 1.6 1.6)
			)
			(justify left top)
		)
		(uuid "42581a99-0df5-4cb6-a4e8-163e8f687237")
	)
	(text "NOTES\n1. The module is an A4988-style StepStick:\n   pin 1 is GND at the bottom right, EN is\n   pin 9 at the top left, 15.24 mm row gap.\n2. CLK (pin 14) is held low by R4 20k on\n   the module for the internal oscillator.\n3. SPREAD has no header pin on V1.3. R7\n   is not fitted, so StealthChop is used.\n4. Connect the motor before applying VM.\n   Do not hot-plug the motor.\n5. Keep the 100 uF bulk capacitor within\n   50 mm of the module VS pin.\n6. If the motor runs backwards, swap A1\n   and A2 (or B1 and B2)."
		(exclude_from_sim no)
		(at 12.7 134.62 0)
		(effects
			(font
				(size 1.6 1.6)
			)
			(justify left top)
		)
		(uuid "b4498ea7-fdc4-44d3-8d60-11289aa02825")
	)
	(text "The diamond symbols are PWR_FLAG.\nThey are ERC markers only and are\nnot fitted parts."
		(exclude_from_sim no)
		(at 325.12 62.23 0)
		(effects
			(font
				(size 1.6 1.6)
			)
			(justify left top)
		)
		(uuid "ef89a10f-3982-4a78-be1f-6c754deeacec")
	)
	(text "The U1 symbol shows only the WeAct header pins used here.\nThe board has two rows of 24 pins at 2.54 mm. Pin numbers\non U1 are logical, not physical. Match the names to the\nsilkscreen (for example PA0/A0 is the pad marked A0)."
		(exclude_from_sim no)
		(at 12.7 175.26 0)
		(effects
			(font
				(size 1.6 1.6)
			)
			(justify left top)
		)
		(uuid "1dda7361-f054-4dc1-bacb-173499605e0c")
	)
	(sheet_instances
		(path "/"
			(page "1")
		)
	)
	(embedded_fonts no)
